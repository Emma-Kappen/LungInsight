@pytest.mark.parametrize("sex", ["female", "male"])
def test_sex_is_mapped_unchanged(spy_artifact: dict, sex: str) -> None:
    output = run_inference(_v2_request(sex_at_baseline=sex), artifacts={"cancer_type": spy_artifact})["cancer_type"]
    assert output["status"] == "research_prediction"
    assert spy_artifact["estimator"].frames[-1].iloc[0]["sex_at_baseline"] == sex


@pytest.mark.parametrize(
    ("smoking", "expected"),
    [("never", "never"), ("former", "former_or_current"), ("current", "former_or_current")],
)
def test_smoking_status_is_mapped_to_trained_categories(spy_artifact: dict, smoking: str, expected: str) -> None:
    output = run_inference(_v2_request(smoking_status=smoking), artifacts={"cancer_type": spy_artifact})["cancer_type"]
    assert output["status"] == "research_prediction"
    assert spy_artifact["estimator"].frames[-1].iloc[0]["smoking_history"] == expected
    assert output["feature_values"]["smoking_history"] == expected


@pytest.mark.parametrize("stage", ["stage_1_3", "stage_4"])
def test_supported_stage_categories_are_mapped(spy_artifact: dict, stage: str) -> None:
    output = run_inference(_v2_request(stage_at_baseline=stage), artifacts={"cancer_type": spy_artifact})["cancer_type"]
    assert output["status"] == "research_prediction"
    assert spy_artifact["estimator"].frames[-1].iloc[0]["stage"] == stage


def _assert_abstained(spy_artifact: dict, request: dict, missing: str) -> None:
    output = run_inference(request, artifacts={"cancer_type": spy_artifact})["cancer_type"]
    assert output["status"] == "abstained"
    assert output["missing_features"] == [missing]
    assert "probabilities" not in output and "predicted_class" not in output
    assert output["reason"]
    assert spy_artifact["estimator"].frames == []


@pytest.mark.parametrize("sex", [None, "unknown", "not_reported", "other_or_unspecified"])
def test_unknown_or_missing_sex_abstains(spy_artifact: dict, sex: str | None) -> None:
    _assert_abstained(spy_artifact, _v2_request(sex_at_baseline=sex), "sex_at_baseline")
    _assert_abstained(spy_artifact, _v2_request(drop=("sex_at_baseline",)), "sex_at_baseline")


@pytest.mark.parametrize("smoking", ["unknown", "not_reported"])
def test_unknown_or_missing_smoking_abstains(spy_artifact: dict, smoking: str) -> None:
    _assert_abstained(spy_artifact, _v2_request(smoking_status=smoking), "smoking_status")
    _assert_abstained(spy_artifact, _v2_request(drop=("smoking_status",)), "smoking_status")


@pytest.mark.parametrize("stage", [None, "unknown", "not_reported"])
def test_missing_or_unknown_stage_abstains(spy_artifact: dict, stage: str | None) -> None:
    _assert_abstained(spy_artifact, _v2_request(stage_at_baseline=stage), "stage_at_baseline")
    _assert_abstained(spy_artifact, _v2_request(drop=("stage_at_baseline",)), "stage_at_baseline")


def test_unverified_baseline_abstains_without_calling_the_estimator(spy_artifact: dict) -> None:
    request = _v2_request()
    request["baseline_definition"] = "other_or_unverified"
    output = run_inference(request, artifacts={"cancer_type": spy_artifact})["cancer_type"]
    assert output["status"] == "abstained"
    assert "prediction_baseline_does_not_match_training_baseline" in output["warnings"]
    assert "initial pathologic diagnosis" in output["reason"]
    assert spy_artifact["estimator"].frames == []


def test_valid_inputs_give_finite_normalized_probabilities_and_schema_valid_output(spy_artifact: dict) -> None:
    full = run_inference(_v2_request(), artifacts={"cancer_type": spy_artifact})
    output = full["cancer_type"]
    assert output["status"] == "research_prediction"
    assert output["class_order"] == ["LUAD", "LUSC"]
    assert list(output["probabilities"]) == ["LUAD", "LUSC"]
    values = np.array(list(output["probabilities"].values()))
    assert np.isfinite(values).all() and ((values >= 0) & (values <= 1)).all()
    assert values.sum() == pytest.approx(1.0, abs=1e-6)
    assert output["predicted_class"] == max(output["probabilities"], key=output["probabilities"].get)
    assert output["features_used"] == ["sex_at_baseline", "smoking_history", "stage"]
    assert output["model_version"] == "cancer-type-luad-lusc-v2"
    assert output["calibration_status"] == "not_calibrated"
    assert "conditional on LUAD/LUSC" in output["target"] and "not cancer-versus-benign" in output["target"]
    assert any("not clinically validated" in text for text in output["warnings"])
    schema = json.loads((Path(clinical_inference.__file__).parent / "schemas" / "clinical_prediction_v1.schema.json").read_text(encoding="utf-8"))
    validator = Draft202012Validator(schema, format_checker=FormatChecker())
    assert list(validator.iter_errors(full)) == []
    abstained = run_inference(_v2_request(stage_at_baseline=None), artifacts={"cancer_type": spy_artifact})
    assert list(validator.iter_errors(abstained)) == []


def test_invalid_probability_vector_is_reported_as_a_model_failure(spy_artifact: dict) -> None:
    spy_artifact["estimator"].predict_proba = lambda frame: np.array([[0.9, 0.9]])
    output = run_inference(_v2_request(), artifacts={"cancer_type": spy_artifact})["cancer_type"]
    assert output["status"] == "failed" and output["error_code"] == "model_inference_failed"


# ---- stage input, record persistence, Imaging hand-off -----------------------------------------------


def test_stage_input_validation() -> None:
    assert validate_clinician_inputs({"stage_at_baseline": "stage_1_3"})["stage_at_baseline"] == "stage_1_3"
    assert validate_clinician_inputs({"stage_at_baseline": "stage_4"})["stage_at_baseline_status"] == "reported"
    unknown = validate_clinician_inputs({"stage_at_baseline": "unknown"})
    assert unknown["stage_at_baseline"] is None and unknown["stage_at_baseline_status"] == "unknown"
    legacy = validate_clinician_inputs({"sex_at_baseline": "female"})
    assert legacy.get("stage_at_baseline") is None
    assert legacy["stage_at_baseline_status"] == "not_reported"
    for rejected in ("Stage IIA", "Stage I", "stage_2", "III", "", 4, True):
        with pytest.raises(ClinicalValidationError, match="stage_at_baseline"):
            validate_clinician_inputs({"stage_at_baseline": rejected})
    with pytest.raises(ClinicalInferenceError, match="stage_at_baseline"):
        run_inference(_v2_request(stage_at_baseline="Stage IV"))
    request = _v2_request()
    request["clinician_inputs"]["unsupported_stage_field"] = "stage_4"
    with pytest.raises(ClinicalInferenceError):
        run_inference(request)


@pytest.mark.parametrize("stage", ["stage_1_3", "stage_4", "unknown", None])
def test_saved_stage_round_trips_through_validation(stage: str | None) -> None:
    saved = validate_clinician_inputs({"sex_at_baseline": "male", "stage_at_baseline": stage})
    reread = validate_clinician_inputs(saved)
    assert reread["stage_at_baseline"] == saved["stage_at_baseline"]
    if stage != "unknown":
        assert reread == saved
    assert saved["stage_at_baseline_status"] == {"stage_1_3": "reported", "stage_4": "reported", "unknown": "unknown", None: "not_reported"}[stage]


def test_clinical_record_api_preserves_stage_and_loads_legacy_records(
    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
) -> None:
    from fastapi.testclient import TestClient
    from LungInsight_v2.backend.Clinical import api as clinical_api

    monkeypatch.setattr(clinical_api, "IMAGING_OUTPUT_ROOT", tmp_path)
    client = TestClient(create_app())
    for stage, restored, status in (("stage_4", "stage_4", "reported"), ("unknown", None, "unknown"), (None, None, "not_reported")):
        response = client.put(
            "/api/v1/clinical/records/stage-patient",
            json={"clinician_inputs": {"sex_at_baseline": "female", "stage_at_baseline": stage}},
        )
        assert response.status_code == 200
        loaded = client.get("/api/v1/clinical/records/stage-patient").json()["clinician_inputs"]
        assert loaded["stage_at_baseline"] == restored
        assert loaded["stage_at_baseline_status"] == status
        assert validate_clinician_inputs(loaded)["stage_at_baseline"] == restored
    assert client.put(
        "/api/v1/clinical/records/stage-patient",
        json={"clinician_inputs": {"stage_at_baseline": "Stage IV"}},
    ).status_code == 422
    legacy = {
        "schema_version": "clinical-intake-record-v1",
        "patient_id": "legacy-patient",
        "saved_at": "2026-01-01T00:00:00+00:00",
        "clinician_inputs": {"sex_at_baseline": "female", "smoking_status": "never"},
    }
    (tmp_path / ".clinical_records" / "legacy-patient.json").write_text(json.dumps(legacy), encoding="utf-8")
    loaded = client.get("/api/v1/clinical/records/legacy-patient").json()["clinician_inputs"]
    assert "stage_at_baseline" not in loaded
    revalidated = validate_clinician_inputs(loaded)
    assert revalidated.get("stage_at_baseline") is None
    assert revalidated["stage_at_baseline_status"] == "not_reported"
    artifact = adapt_cancer_type_pipeline(_v2_pipeline())
    request = _v2_request(drop=("stage_at_baseline",))
    request["clinician_inputs"] = {**request["clinician_inputs"], **loaded}
    assert run_inference(request, artifacts={"cancer_type": artifact})["cancer_type"]["status"] == "abstained"


def test_imaging_analysis_hands_stage_to_clinical_inference(
    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, isolated_artifacts: Path
) -> None:
    from LungInsight_v2.backend.Imaging.api import analysis as analysis_api

    patient_id = "stage-handoff"
    job_dir = tmp_path / patient_id / "dicom_uploads" / "job1" / "stage01_input" / patient_id
    job_dir.mkdir(parents=True)
    captured: dict = {}
    pipeline_called = threading.Event()
    monkeypatch.setattr(
        analysis_api,
        "get_dicom_job",
        lambda *_args, **_kwargs: {
            "patient_id": patient_id,
            "status": "preprocessing_complete",
            "pipeline_input": f"dicom_uploads/job1/stage01_input/{patient_id}",
        },
    )

    def fake_pipeline(**kwargs) -> None:
        captured.update(kwargs)
        pipeline_called.set()

    monkeypatch.setattr(analysis_api, "_run_pipeline", fake_pipeline)
    inputs = {"sex_at_baseline": "female", "smoking_status": "never", "stage_at_baseline": "stage_4"}
    started = analysis_api.start_analysis(
        project_root=tmp_path,
        output_root=tmp_path,
        patient_id=patient_id,
        upload_job_id="job1",
        clinical_inputs=inputs,
        requested_malignancy_method="brock",
        data_provenance=None,
        baseline_definition="initial_pathologic_diagnosis",
    )
    try:
        assert pipeline_called.wait(timeout=10)
        assert captured["clinical_inputs"]["stage_at_baseline"] == "stage_4"
        request = _request()
        request["clinician_inputs"] = captured["clinical_inputs"]
        output = run_inference(request, artifacts=load_deployed_artifacts())
        assert output["cancer_type"]["status"] == "research_prediction"
        assert set(output["cancer_type"]["feature_values"]) == {"sex_at_baseline", "smoking_history"}
        assert "stage_at_baseline" in output["input_validation"]["clinician_fields_supplied"]
    finally:
        analysis_api._RUNS.pop(started["run_id"], None)


# ---- frontend regression -----------------------------------------------------------------------------


def _js_function(source: str, name: str) -> str:
    match = re.search(rf"^function {name}\(.*?^}}", source, re.S | re.M)
    assert match, f"{name} not found in app.js"
    return match.group(0)


def test_stage_selector_and_record_paths_exist_in_frontend() -> None:
    page = (FRONTEND_DIR / "index.html").read_text(encoding="utf-8")
    script = (FRONTEND_DIR / "app.js").read_text(encoding="utf-8")
    select = re.search(r'<select id="stage_at_baseline".*?</select>', page, re.S).group(0)
    assert re.search(r'<option value="" selected>', select)
    assert '<option value="stage_1_3">Stage I–III</option>' in select
    assert '<option value="stage_4">Stage IV</option>' in select
    assert '<option value="unknown">Unknown / not reported</option>' in select
    assert 'stage: val("stage_at_baseline")' in script
    assert "stage_at_baseline: f.stage || null" in script
    assert 'set("stage_at_baseline"' in _js_function(script, "applyClinicalRecord")
    assert "Stage" in _js_function(script, "renderClinicalInputs")


def test_nodule_brock_assessment_no_longer_renders_histology() -> None:
    script = (FRONTEND_DIR / "app.js").read_text(encoding="utf-8")
    assessment = _js_function(script, "assessmentHtml")
    assert "cancer_type" not in assessment and "LUAD" not in assessment and "cancerType" not in assessment
    assert "Likely cancer type" not in script


@pytest.mark.skipif(shutil.which("node") is None, reason="node is not installed")
def test_subtype_panel_is_independent_of_brock_and_survival(tmp_path: Path) -> None:
    script_path = tmp_path / "panel.js"
    script_path.write_text(
        r"""
const fs = require("fs");
const source = fs.readFileSync(process.argv[2], "utf8");
const line = (name) => source.match(new RegExp(`^const ${name} = .*$`, "m"))[0];
const fn = (name) => source.match(new RegExp(`^function ${name}\\(.*?^}`, "ms"))[0];
const code = [
  line("esc"), line("label"), line("badge"), line("CANCER_STAGE_LABELS"), line("SMOKING_HISTORY_LABELS"),
  fn("survivalChartHtml"), fn("cancerTypePanelHtml"), fn("modelResultHtml"), fn("renderClinicalModels"),
  "return {renderClinicalModels, cancerTypePanelHtml};",
].join("\n");
const out = {};
const S = {run: {body: {}}};
const factory = new Function("S", "$", code);
const api = factory(S, (id) => ({set innerHTML(v) { out[id] = v; }}));
const survival = {status: "research_prediction", prediction: {
  survival_function: {time_days: [0, 365, 1826], probability: [1, 0.8, 0.5]}, probability_at_horizons_days: {"365": 0.8}}};
const cancer = {status: "research_prediction", probabilities: {LUAD: 0.7, LUSC: 0.3}, predicted_class: "LUAD",
  feature_values: {sex_at_baseline: "female", smoking_history: "never", stage: "stage_4"}, limitations: ["<b>x</b>"]};
const abstained = {status: "abstained", prediction: null, reason: "Required inputs are missing: stage_at_baseline.", missing_features: ["stage_at_baseline"], warnings: ["required_model_inputs_missing"]};
const render = (prediction) => { S.run.body = {clinical_prediction: prediction}; api.renderClinicalModels(); return out["b-models"]; };
const results = {
  both: render({survival, cancer_type: cancer}),
  noSurvival: render({survival: {status: "not_trained", prediction: null, reason: "No survival model."}, cancer_type: cancer}),
  noCancer: render({survival, cancer_type: {status: "not_trained", prediction: null, reason: "No cancer model."}}),
  abstained: render({survival, cancer_type: abstained}),
  missing: render({survival}),
  escaped: api.cancerTypePanelHtml({...cancer, predicted_class: "<img src=x>"}),
};
console.log(JSON.stringify(results));
""",
        encoding="utf-8",
    )
    completed = subprocess.run(
        ["node", str(script_path), str(FRONTEND_DIR / "app.js")],
        capture_output=True, text=True, timeout=60, check=False,
    )
    assert completed.returncode == 0, completed.stderr
    html = json.loads(completed.stdout)
    assert "class=\"chart\"" in html["both"] and "LUAD" in html["both"] and "LUSC" in html["both"]
    assert "research model output" in html["both"] and "stage: Stage IV" in html["both"]
    assert "No survival model." in html["noSurvival"] and "LUAD" in html["noSurvival"]
    assert 'class="chart"' in html["noCancer"] and "No cancer model." in html["noCancer"]
    assert 'class="chart"' in html["abstained"] and "stage_at_baseline" in html["abstained"]
    assert "Required inputs are missing" in html["abstained"] and "ct-row" not in html["abstained"]
    assert 'class="chart"' in html["missing"] and "Histology" in html["missing"]
    assert "&lt;b&gt;x&lt;/b&gt;" in html["both"] and "<b>x</b>" not in html["both"]
    assert "<img" not in html["escaped"] and "&lt;img" in html["escaped"]
