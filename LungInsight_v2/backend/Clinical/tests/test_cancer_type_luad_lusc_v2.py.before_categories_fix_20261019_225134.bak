FRONTEND_DIR = Path(__file__).resolve().parents[3] / "frontend"
ENV_NAME = "LUNGINSIGHT_CLINICAL_ARTIFACT"


def _v2_pipeline(stage_values: tuple[str, ...] = ("stage_1_3", "stage_4")):
    from sklearn.compose import ColumnTransformer
    from sklearn.impute import SimpleImputer
    from sklearn.linear_model import LogisticRegression
    from sklearn.pipeline import Pipeline
    from sklearn.preprocessing import OneHotEncoder

    columns = ["sex_at_baseline", "smoking_history", "stage"]
    rows = [
        (sex, smoking, stage)
        for sex in ("female", "male")
        for smoking in ("former_or_current", "never")
        for stage in stage_values
    ] * 3
    frame = pd.DataFrame(rows, columns=columns)
    labels = ["LUSC" if index % 3 == 0 else "LUAD" for index in range(len(frame))]
    pipeline = Pipeline([
        ("preprocessing", ColumnTransformer([(
            "categorical",
            Pipeline([
                ("imputer", SimpleImputer(strategy="most_frequent")),
                ("onehot", OneHotEncoder(handle_unknown="ignore")),
            ]),
            columns,
        )])),
        ("classifier", LogisticRegression(class_weight="balanced", max_iter=2000, random_state=42)),
    ])
    return pipeline.fit(frame, labels)


class _SpyEstimator:
    def __init__(self, inner) -> None:
        self.inner = inner
        self.classes_ = inner.classes_
        self.frames: list[pd.DataFrame] = []

    def predict_proba(self, frame: pd.DataFrame):
        self.frames.append(frame.copy())
        return self.inner.predict_proba(frame)


@pytest.fixture
def spy_artifact() -> dict:
    artifact = adapt_cancer_type_pipeline(_v2_pipeline())
    artifact["estimator"] = _SpyEstimator(artifact["estimator"])
    return artifact


def _v2_request(drop: tuple[str, ...] = (), **clinician) -> dict:
    request = _request()
    request["clinician_inputs"].update({
        "sex_at_baseline": "female",
        "smoking_status": "never",
        "stage_at_baseline": "stage_1_3",
    })
    request["clinician_inputs"].update(clinician)
    for name in drop:
        request["clinician_inputs"].pop(name, None)
    return request


@pytest.fixture
def isolated_artifacts(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> Path:
    monkeypatch.delenv(ENV_NAME, raising=False)
    monkeypatch.setattr(clinical_inference, "DEFAULT_ARTIFACT_PATH", tmp_path / "no-default-bundle.joblib")
    clinical_inference._cached_artifacts.cache_clear()
    clinical_inference._cached_standalone_cancer_type.cache_clear()
    yield tmp_path
    clinical_inference._cached_artifacts.cache_clear()
    clinical_inference._cached_standalone_cancer_type.cache_clear()


def _write_bundle(path: Path, *, cancer_type: dict | None, survival: dict | None) -> Path:
    joblib.dump(
        {"schema_version": "1.0.0", "cancer_type": cancer_type, "survival": survival, "provenance": {}},
        path,
    )
    return path


def _legacy_cancer_type() -> dict:
    return {"estimator": "legacy-estimator", "metadata": {"model_version": "legacy-cancer-type"}}


def _survival_stub() -> dict:
    return {"estimator": "survival-estimator", "metadata": {"model_version": "survival-stub"}}


# ---- artifact loading --------------------------------------------------------------------------------


def test_real_standalone_model_loads_through_deployed_artifact_path(isolated_artifacts: Path) -> None:
    artifacts = load_deployed_artifacts()
    assert artifacts is not None
    assert artifacts["survival"] is None
    metadata = artifacts["cancer_type"]["metadata"]
    assert metadata["model_version"] == "cancer-type-luad-lusc-v2"
    assert metadata["class_order"] == ["LUAD", "LUSC"]
    assert metadata["feature_order"] == ["sex_at_baseline", "smoking_history"]
    assert metadata["training_categories"] == {
        "sex_at_baseline": ["female", "male"],
        "smoking_history": ["former_or_current", "never"],
        "stage": ["stage_1_3", "stage_4"],
    }
    assert describe_artifacts(artifacts)["cancer_type_model"] == "loaded"
    output = run_inference(_v2_request(), artifacts=artifacts)["cancer_type"]
    assert output["status"] == "research_prediction"
    assert set(output["probabilities"]) == {"LUAD", "LUSC"}
    assert output["model_version"] == "cancer-type-luad-lusc-v2"


def test_default_bundle_survival_is_kept_and_its_cancer_type_is_superseded(
    isolated_artifacts: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    bundle = _write_bundle(isolated_artifacts / "default.joblib", cancer_type=_legacy_cancer_type(), survival=_survival_stub())
    monkeypatch.setattr(clinical_inference, "DEFAULT_ARTIFACT_PATH", bundle)
    artifacts = load_deployed_artifacts()
    assert artifacts["survival"] == _survival_stub()
    assert artifacts["cancer_type"]["metadata"]["model_version"] == "cancer-type-luad-lusc-v2"


def test_explicitly_configured_bundle_uses_v2_cancer_type_and_preserves_survival(
    isolated_artifacts: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    bundle = _write_bundle(isolated_artifacts / "configured.joblib", cancer_type=_legacy_cancer_type(), survival=_survival_stub())
    monkeypatch.setenv(ENV_NAME, str(bundle))
    artifacts = load_deployed_artifacts()
    assert artifacts["cancer_type"]["metadata"]["model_version"] == "cancer-type-luad-lusc-v2"
    assert artifacts["cancer_type"]["metadata"]["artifact_source"] == "standalone_pipeline"
    assert artifacts["survival"] == _survival_stub()
    assert describe_artifacts(artifacts)["cancer_type_model_source"] == "standalone_pipeline"


def test_configured_bundle_without_cancer_type_is_filled_without_touching_survival(
    isolated_artifacts: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    bundle = _write_bundle(isolated_artifacts / "configured.joblib", cancer_type=None, survival=_survival_stub())
    monkeypatch.setenv(ENV_NAME, str(bundle))
    artifacts = load_deployed_artifacts()
    assert artifacts["cancer_type"]["metadata"]["model_version"] == "cancer-type-luad-lusc-v2"
    assert artifacts["survival"] == _survival_stub()
    survival = _survival_stub()
    models = {"cancer_type": None, "survival": survival}
    assert with_standalone_cancer_type(models, bundle_configured=True)["survival"] is survival
    assert models["cancer_type"] is None


def test_survival_inference_is_independent_of_the_standalone_cancer_type(isolated_artifacts: Path) -> None:
    rng = np.random.default_rng(29)
    n = 200
    frame = pd.DataFrame({
        "patient_id": [f"v2-survival-{i}" for i in range(n)],
        "source": np.where(np.arange(n) % 2, "TCGA-LUAD", "TCGA-LUSC"),
        "age_at_baseline_years": rng.normal(65, 6, n),
        "sex_at_baseline": np.where(np.arange(n) % 2, "female", "male"),
        "stage_at_baseline": np.where(np.arange(n) % 3, "Stage I", "Stage III"),
        "overall_survival_time_days": rng.uniform(100, 2500, n),
        "overall_survival_event": np.arange(n) % 4 != 0,
        "endpoint_issue": None,
    })
    survival_artifact, _ = fit_survival_model(frame, use_authorized=True, random_state=15)
    merged = with_standalone_cancer_type(
        {"cancer_type": None, "survival": survival_artifact}, bundle_configured=True
    )
    request = _v2_request(age_at_baseline_years=65, ecog=None)
    output = run_inference(request, artifacts=merged)
    assert output["survival"]["status"] == "research_prediction"
    assert output["cancer_type"]["status"] == "research_prediction"
    abstaining = run_inference(_v2_request(stage_at_baseline=None, age_at_baseline_years=65, ecog=None), artifacts=merged)
    assert abstaining["cancer_type"]["status"] == "research_prediction"
    assert abstaining["survival"]["status"] == "research_prediction"


def test_standalone_cache_follows_file_changes_and_invalid_model_does_not_hide_survival(
    isolated_artifacts: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    model_path = isolated_artifacts / "cancer-type.joblib"
    monkeypatch.setattr(clinical_inference, "CANCER_TYPE_V2_PATH", model_path)
    bundle = _write_bundle(isolated_artifacts / "default.joblib", cancer_type=None, survival=_survival_stub())
    monkeypatch.setattr(clinical_inference, "DEFAULT_ARTIFACT_PATH", bundle)

    assert load_deployed_artifacts()["cancer_type"] is None
    assert describe_artifacts(load_deployed_artifacts())["cancer_type_model"] == "not_trained"

    joblib.dump(_v2_pipeline(), model_path)
    assert load_deployed_artifacts()["cancer_type"]["metadata"]["model_version"] == "cancer-type-luad-lusc-v2"

    model_path.write_bytes(b"not a joblib file")
    stat = model_path.stat()
    os.utime(model_path, ns=(stat.st_atime_ns, stat.st_mtime_ns + 5_000_000_000))
    artifacts = load_deployed_artifacts()
    assert describe_artifacts(artifacts)["cancer_type_model"] == "invalid"
    assert artifacts["survival"] == _survival_stub()
    output = run_inference(_v2_request(), artifacts=artifacts)
    assert output["cancer_type"]["status"] == "failed"
    assert output["cancer_type"]["error_code"] == "model_artifact_invalid"

    joblib.dump(_v2_pipeline(), model_path)
    os.utime(model_path, ns=(stat.st_atime_ns, stat.st_mtime_ns + 10_000_000_000))
    assert describe_artifacts(load_deployed_artifacts())["cancer_type_model"] == "loaded"


def test_standalone_pipeline_must_match_documented_categories(tmp_path: Path) -> None:
    widened = tmp_path / "widened.joblib"
    joblib.dump(_v2_pipeline(stage_values=("stage_1_3", "stage_4", "stage_unknown")), widened)
    with pytest.raises(ClinicalInferenceError, match="documented contract"):
        load_cancer_type_pipeline(widened)
    wrong = tmp_path / "wrong.joblib"
    joblib.dump({"not": "a pipeline"}, wrong)
    with pytest.raises(ClinicalInferenceError, match="structure"):
        load_cancer_type_pipeline(wrong)
    assert load_cancer_type_pipeline(tmp_path / "missing.joblib") is None


def test_status_endpoint_reports_actual_model_availability(
    isolated_artifacts: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    from fastapi.testclient import TestClient

    bundle = _write_bundle(isolated_artifacts / "configured.joblib", cancer_type=None, survival=_survival_stub())
    status = TestClient(create_app(str(bundle))).get("/api/v1/clinical/status").json()
    assert status["cancer_type_model"] == "loaded"
    assert status["cancer_type_model_source"] == "standalone_pipeline"
    assert status["survival_model"] == "loaded"
    monkeypatch.setattr(clinical_inference, "CANCER_TYPE_V2_PATH", isolated_artifacts / "missing.joblib")
    clinical_inference._cached_standalone_cancer_type.cache_clear()
    status = TestClient(create_app(str(bundle))).get("/api/v1/clinical/status").json()
    assert status["cancer_type_model"] == "not_trained"
    assert status["survival_model"] == "loaded"


