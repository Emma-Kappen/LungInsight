{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunginsight.invalid/schemas/clinical_prediction_v1.schema.json",
  "title": "LungInsight Clinical Prediction Output v1",
  "type": "object",
  "required": [
    "schema_version",
    "patient_id",
    "study_id",
    "prediction_baseline_datetime",
    "baseline_definition",
    "input_validation",
    "imaging_context",
    "cancer_type",
    "survival",
    "provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "patient_id": {"type": "string"},
    "study_id": {"type": "string"},
    "prediction_baseline_datetime": {"type": "string", "format": "date-time"},
    "baseline_definition": {
      "enum": ["initial_pathologic_diagnosis", "other_or_unverified"]
    },
    "requested_malignancy_method": {
      "enum": ["brock", null]
    },
    "input_validation": {"type": "object"},
    "imaging_context": {"type": "object"},
    "cancer_type": {"type": "object"},
    "survival": {"type": "object"},
    "provenance": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
