{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunginsight.invalid/schemas/imaging_clinical_contract_v2.schema.json",
  "title": "LungInsight Imaging-to-Clinical Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "patient_id",
    "study_id",
    "study_uid",
    "series_uid",
    "coordinate_metadata",
    "study",
    "nodules"
  ],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "patient_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "study_uid": {"type": "string", "minLength": 1},
    "series_uid": {"type": "string", "minLength": 1},
    "coordinate_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["array_axes", "coordinate_system", "origin_mm", "spacing_zyx_mm", "direction_lps"],
      "properties": {
        "array_axes": {"const": ["z", "y", "x"]},
        "coordinate_system": {"const": "DICOM_LPS"},
        "origin_mm": {"$ref": "#/$defs/vector3"},
        "spacing_zyx_mm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "direction_lps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/vector3"}
        }
      }
    },
    "study": {"$ref": "#/$defs/study"},
    "nodules": {
      "type": "array",
      "items": {"$ref": "#/$defs/nodule"}
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "count": {"type": ["integer", "null"], "minimum": 0},
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_status",
        "preprocessing_status",
        "mask_validation_status",
        "raw_detection_counts",
        "fused_candidate_count",
        "excluded_candidate_count",
        "eligible_nodule_count",
        "brock_prediction_counts",
        "warnings",
        "errors",
        "provenance",
        "artifact_refs"
      ],
      "properties": {
        "processing_status": {
          "enum": ["not_started", "running", "completed", "incomplete", "blocked", "failed", "interrupted"]
        },
        "preprocessing_status": {"enum": ["not_started", "completed", "incomplete", "blocked", "failed", "unknown"]},
        "mask_validation_status": {
          "enum": ["not_run", "ready_for_review", "validated", "validated_automated", "validated_visual_review", "blocked", "failed", "unknown"]
        },
        "raw_detection_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ViTDet3D", "LoG"],
          "properties": {
            "ViTDet3D": {"$ref": "#/$defs/count"},
            "LoG": {"$ref": "#/$defs/count"}
          }
        },
        "fused_candidate_count": {"$ref": "#/$defs/count"},
        "excluded_candidate_count": {"$ref": "#/$defs/count"},
        "eligible_nodule_count": {"$ref": "#/$defs/count"},
        "brock_prediction_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "incomplete", "failed", "not_run"],
          "properties": {
            "completed": {"type": "integer", "minimum": 0},
            "incomplete": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "not_run": {"type": "integer", "minimum": 0}
          }
        },
        "warnings": {"type": "array", "items": {"type": "string"}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "object"},
        "artifact_refs": {"type": "object"}
      }
    },
    "nodule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_nodule_id",
        "eligibility_status",
        "quality_status",
        "detector",
        "detection_sources",
        "bbox_voxel",
        "bbox_lps_mm",
        "centroid_voxel",
        "centroid_lps_mm",
        "measurements",
        "anatomical_location",
        "classification",
        "malignancy",
        "input_completeness",
        "uncertainty",
        "quality_flags",
        "model_versions",
        "gradcam_refs",
        "shap_refs",
        "artifact_refs"
      ],
      "properties": {
        "stable_nodule_id": {"type": "string", "minLength": 1},
        "eligibility_status": {"const": "eligible"},
        "quality_status": {"enum": ["passed", "passed_with_warnings"]},
        "detector": {
          "type": "object",
          "required": ["candidate_id", "source", "source_members", "vitdet_score", "log_score"],
          "properties": {
            "candidate_id": {"type": "string", "minLength": 1},
            "source": {"enum": ["ViTDet3D", "LoG", "Merged"]},
            "source_members": {"type": "array", "items": {"type": "object"}},
            "vitdet_score": {"type": ["number", "null"]},
            "log_score": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "detection_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ViTDet3D", "LoG"]}
        },
        "bbox_voxel": {
          "type": "object",
          "required": ["start_zyx", "end_zyx_exclusive"],
          "properties": {
            "start_zyx": {"$ref": "#/$defs/vector3"},
            "end_zyx_exclusive": {"$ref": "#/$defs/vector3"}
          },
          "additionalProperties": false
        },
        "bbox_lps_mm": {
          "type": "object",
          "required": ["min_lps_mm", "max_lps_mm"],
          "properties": {
            "min_lps_mm": {"$ref": "#/$defs/vector3"},
            "max_lps_mm": {"$ref": "#/$defs/vector3"}
          },
          "additionalProperties": false
        },
        "centroid_voxel": {"$ref": "#/$defs/vector3"},
        "centroid_lps_mm": {"$ref": "#/$defs/vector3"},
        "measurements": {
          "type": "object",
          "required": ["diameter_mm", "volume_mm3", "source", "status"],
          "properties": {
            "diameter_mm": {"type": ["number", "null"], "minimum": 0},
            "volume_mm3": {"type": ["number", "null"], "minimum": 0},
            "source": {"type": "string"},
            "status": {"enum": ["detector_estimate", "unavailable"]}
          },
          "additionalProperties": false
        },
        "anatomical_location": {"type": ["object", "null"]},
        "classification": {
          "type": "object",
          "required": ["status", "source", "attributes"],
          "properties": {
            "status": {"enum": ["available", "partial", "unavailable"]},
            "source": {"type": ["string", "null"]},
            "attributes": {"type": "object"}
          },
          "additionalProperties": true
        },
        "malignancy": {
          "type": "object",
          "required": ["brock", "selected_prediction"],
          "properties": {
            "brock": {"$ref": "#/$defs/brock"},
            "selected_prediction": {"$ref": "#/$defs/selected_prediction"}
          },
          "additionalProperties": false
        },
        "input_completeness": {"type": "object"},
        "uncertainty": {"type": "object"},
        "quality_flags": {"type": "array", "items": {"type": "string"}},
        "model_versions": {"type": "object"},
        "gradcam_refs": {"type": "object"},
        "shap_refs": {"type": "object"},
        "artifact_refs": {"type": "object"}
      }
    },
    "brock": {
      "type": "object",
      "required": ["status", "method", "model_name", "model_version", "target", "probability", "features_missing", "feature_contributions", "limitations"],
      "properties": {
        "status": {"enum": ["available", "incomplete", "invalid_input", "unsupported", "error", "not_run"]},
        "method": {"type": "string"},
        "model_name": {"const": "Brock_PanCan_full"},
        "model_version": {"type": ["string", "null"]},
        "formula_version": {"type": ["string", "null"]},
        "reference": {"type": ["string", "null"]},
        "target": {"type": "string"},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "logit": {"type": ["number", "null"]},
        "features_missing": {"type": "array", "items": {"type": "string"}},
        "feature_contributions": {"type": "array", "items": {"type": "object"}},
        "calculation_timestamp": {"type": ["string", "null"], "format": "date-time"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "failure_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "selected_prediction": {
      "type": "object",
      "required": ["method", "model_version", "status", "probability", "value", "missing_inputs", "limitations"],
      "properties": {
        "method": {"const": "brock"},
        "model_version": {"type": ["string", "null"]},
        "status": {"enum": ["available", "incomplete", "invalid_input", "unsupported", "error", "not_run"]},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "value": {"type": ["number", "null"]},
        "rounded": {"type": ["integer", "null"]},
        "inputs_used": {},
        "missing_inputs": {"type": "array", "items": {"type": "string"}},
        "validation_warnings": {"type": "array", "items": {"type": "string"}},
        "explanation": {},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
