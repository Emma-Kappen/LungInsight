"""Adapter for Stage 05 Grad-CAM using frozen spatial-v1 checkpoints."""
import torch
import torch.nn as nn

from backend.models.nodule_ranker_3d_distributional_v1.spatial_v1.model_objective import (
    MODEL_TARGETS,
    SpatialObjectiveModel,
    preprocess_hu,
)

ATTRIBUTES = (
    "subtlety",
    "sphericity",
    "margin",
    "lobulation",
    "spiculation",
    "texture",
)


class GradCAMAttributeModel(nn.Module):
    def __init__(self, model):
        super().__init__()
        self.core = model

    def forward(self, raw_hu):
        x = preprocess_hu(raw_hu)
        outputs = self.core(x)
        expected = self.core.expected_ratings(outputs)
        return {
            name: expected[:, MODEL_TARGETS.index(name)]
            for name in ATTRIBUTES
        }


def load_gradcam_model(checkpoint_path, device):
    checkpoint = torch.load(
        checkpoint_path,
        map_location="cpu",
        weights_only=False,
    )
    architecture = checkpoint["architecture"]

    if architecture["objective"] != "ordinal_reader":
        raise ValueError(
            "Stage 05 expects an ordinal_reader checkpoint."
        )

    model = SpatialObjectiveModel(
        architecture["objective"],
        architecture["attention_dim"],
        architecture["head_hidden"],
        architecture["dropout"],
    )
    model.load_state_dict(checkpoint["model_state_dict"], strict=True)
    model.eval()

    return GradCAMAttributeModel(model).to(device).eval()
