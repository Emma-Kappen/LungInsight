{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunginsight.invalid/schemas/imaging_clinical_contract_v1.schema.json",
  "title": "LungInsight Imaging-to-Clinical Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "patient_id",
    "study_id",
    "study_uid",
    "series_uid",
    "coordinate_metadata",
    "nodules"
  ],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "patient_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "study_uid": {"type": "string", "minLength": 1},
    "series_uid": {"type": "string", "minLength": 1},
    "coordinate_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["array_axes", "coordinate_system", "origin_mm", "spacing_zyx_mm", "direction_lps"],
      "properties": {
        "array_axes": {"const": ["z", "y", "x"]},
        "coordinate_system": {"const": "DICOM_LPS"},
        "origin_mm": {"$ref": "#/$defs/vector3"},
        "spacing_zyx_mm": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "direction_lps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/vector3"}
        }
      }
    },
    "nodules": {
      "type": "array",
      "items": {"$ref": "#/$defs/nodule"}
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "nodule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_nodule_id",
        "detector",
        "bbox_voxel",
        "bbox_lps_mm",
        "centroid_voxel",
        "centroid_lps_mm",
        "diameter_mm",
        "volume_mm3",
        "anatomical_location",
        "attributes",
        "malignancy",
        "uncertainty",
        "quality_flags",
        "model_versions",
        "gradcam_refs",
        "shap_refs",
        "artifact_refs"
      ],
      "properties": {
        "stable_nodule_id": {"type": "string", "minLength": 1},
        "detector": {
          "type": "object",
          "required": ["candidate_id", "source", "source_members", "vitdet_score", "log_score"],
          "properties": {
            "candidate_id": {"type": "string", "minLength": 1},
            "source": {"enum": ["ViTDet3D", "LoG", "Merged"]},
            "source_members": {"type": "array", "items": {"type": "object"}},
            "vitdet_score": {"type": ["number", "null"]},
            "log_score": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "bbox_voxel": {
          "type": "object",
          "required": ["start_zyx", "end_zyx_exclusive"],
          "properties": {
            "start_zyx": {"$ref": "#/$defs/vector3"},
            "end_zyx_exclusive": {"$ref": "#/$defs/vector3"}
          },
          "additionalProperties": false
        },
        "bbox_lps_mm": {
          "type": "object",
          "required": ["min_lps_mm", "max_lps_mm"],
          "properties": {
            "min_lps_mm": {"$ref": "#/$defs/vector3"},
            "max_lps_mm": {"$ref": "#/$defs/vector3"}
          },
          "additionalProperties": false
        },
        "centroid_voxel": {"$ref": "#/$defs/vector3"},
        "centroid_lps_mm": {"$ref": "#/$defs/vector3"},
        "diameter_mm": {"type": ["number", "null"], "minimum": 0},
        "volume_mm3": {"type": ["number", "null"], "minimum": 0},
        "anatomical_location": {"type": "object"},
        "attributes": {
          "type": "object",
          "required": [
            "subtlety",
            "internal_structure",
            "calcification",
            "sphericity",
            "margin",
            "lobulation",
            "spiculation",
            "texture"
          ],
          "properties": {
            "subtlety": {"type": "object"},
            "internal_structure": {"type": "object"},
            "calcification": {"type": "object"},
            "sphericity": {"type": "object"},
            "margin": {"type": "object"},
            "lobulation": {"type": "object"},
            "spiculation": {"type": "object"},
            "texture": {"type": "object"}
          },
          "additionalProperties": false
        },
        "malignancy": {
          "type": "object",
          "required": ["brock", "selected_prediction"],
          "properties": {
            "brock": {"$ref": "#/$defs/brock_explanation"},
            "selected_prediction": {"$ref": "#/$defs/selected_prediction"}
          },
          "additionalProperties": false
        },
        "uncertainty": {"type": "object"},
        "quality_flags": {"type": "array", "items": {"type": "string"}},
        "model_versions": {"type": "object"},
        "gradcam_refs": {"type": "object"},
        "shap_refs": {"type": "object"},
        "artifact_refs": {"type": "object"}
      }
    },
    "brock_explanation": {
      "type": "object",
      "required": ["status", "method", "model_name", "model_version", "target", "features_missing", "feature_contributions", "limitations"],
      "properties": {
        "status": {"enum": ["available", "incomplete", "invalid_input", "unsupported", "error"]},
        "method": {"type": "string"},
        "model_name": {"const": "Brock_PanCan_full"},
        "model_version": {"type": "string"},
        "formula_version": {"type": "string"},
        "reference": {"type": "string"},
        "target": {"type": "string"},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "logit": {"type": "number"},
        "features_missing": {"type": "array", "items": {"type": "string"}},
        "feature_contributions": {"type": "array", "items": {"type": "object"}},
        "calculation_timestamp": {"type": "string", "format": "date-time"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "failure_reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "selected_prediction": {
      "type": "object",
      "required": ["method", "model_version", "status", "probability", "value", "missing_inputs", "limitations"],
      "properties": {
        "method": {"const": "brock"},
        "model_version": {"type": ["string", "null"]},
        "status": {"enum": ["available", "incomplete", "invalid_input", "unsupported", "error"]},
        "probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "value": {"type": ["number", "null"]},
        "rounded": {"type": ["integer", "null"]},
        "inputs_used": {},
        "missing_inputs": {"type": "array", "items": {"type": "string"}},
        "validation_warnings": {"type": "array", "items": {"type": "string"}},
        "explanation": {},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
