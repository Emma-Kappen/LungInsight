{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunginsight.invalid/schemas/clinical_prediction_v1.schema.json",
  "title": "LungInsight Clinical Prediction Output v1",
  "type": "object",
  "required": [
    "schema_version",
    "patient_id",
    "study_id",
    "prediction_baseline_datetime",
    "baseline_definition",
    "input_validation",
    "imaging_context",
    "cancer_type",
    "survival",
    "provenance",
    "limitations",
    "cancer_type_v4"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "patient_id": {
      "type": "string"
    },
    "study_id": {
      "type": "string"
    },
    "prediction_baseline_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_definition": {
      "enum": [
        "initial_pathologic_diagnosis",
        "other_or_unverified"
      ]
    },
    "requested_malignancy_method": {
      "enum": [
        "brock",
        null
      ]
    },
    "input_validation": {
      "type": "object"
    },
    "imaging_context": {
      "type": "object"
    },
    "cancer_type": {
      "type": "object",
      "properties": {
        "explanation": {
          "type": "object",
          "description": "Optional exact interventional SHAP explanation for histology model probabilities.",
          "required": [
            "status",
            "method",
            "output_space",
            "class_order",
            "base_values",
            "prediction_values",
            "feature_contributions",
            "reference_population",
            "limitations"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable"
              ]
            },
            "method": {
              "type": "string"
            },
            "output_space": {
              "type": "string"
            },
            "class_order": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "base_values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "prediction_values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "feature_contributions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "feature",
                  "feature_value",
                  "values"
                ],
                "properties": {
                  "feature": {
                    "type": "string"
                  },
                  "feature_value": {},
                  "values": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "reference_population": {
              "type": "object",
              "properties": {
                "cohort": {
                  "type": "string"
                },
                "partition": {
                  "type": "string"
                },
                "rows": {
                  "type": "integer",
                  "minimum": 0
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "survival": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cancer_type_v4": {
      "type": "object",
      "description": "Independent TCGA-only v4 LUAD/LUSC research classifier output, including the unchanged 19-feature input row and provenance.",
      "properties": {
        "model_inputs_used": {
          "type": "object",
          "properties": {
            "age_at_diagnosis": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "sex": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "race": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "ethnicity": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "smoking_history_code": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "pack_years": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "smoking_year_started": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "smoking_year_stopped": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "dlco_percent_predicted": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "fev1_fvc_post_percent": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "fev1_fvc_pre_percent": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "fev1_percent_predicted_post": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "fev1_percent_predicted_pre": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "pulmonary_function_test_performed": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "ecog_preoperative": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "karnofsky_preoperative": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "lung_location": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "anatomic_subdivision": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "other_malignancy_history": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "input_provenance": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "imaging",
              "form",
              "imputed"
            ]
          }
        },
        "imaging_features_available": {
          "type": "boolean"
        },
        "imaging_derived": {
          "type": "object",
          "properties": {
            "n_malignant_nodules": {
              "type": "integer",
              "minimum": 0
            },
            "malignant_nodule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mean_nodule_size_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "mean_attribute_ranks": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "lung_location": {
              "type": [
                "string",
                "null"
              ]
            },
            "anatomic_subdivision": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "spacing_available": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
